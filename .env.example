# Public Supabase project connection (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Server-only. Used by API routes (app/api/**) to bypass RLS for admin
# operations (login lookup, writes gated by application-level auth checks).
# NEVER expose this to the browser / NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Server-only. Signs the short-lived JWT issued at login that PostgREST uses
# to evaluate RLS policies (request.jwt.claims). Must match the "JWT Secret"
# shown in Supabase Dashboard -> Project Settings -> API -> JWT Settings.
SUPABASE_JWT_SECRET=YOUR-PROJECT-JWT-SECRET

# Storage bucket used for evidence photos (created by the SQL migrations).
NEXT_PUBLIC_EVIDENCE_BUCKET=activity-evidence

# Server-only, optional. Telegram bot token from @BotFather. Powers
# notifications (new activity scheduled, form review decided) to any user
# with a telegram_chat_id set in Admin Panel -> User Management. Leave unset
# to run without notifications — sends are best-effort and never block the
# action they're attached to.
TELEGRAM_BOT_TOKEN=

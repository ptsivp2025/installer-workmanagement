<?xml version="1.0" encoding="utf-8"?>
<!-- Shown by Android itself the instant the app is tapped, before any code
     runs, so launch goes white-screen-with-logo → loading screen → app,
     never a blank or half-drawn page. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />
    <item>
        <bitmap android:gravity="center" android:src="@drawable/ic_launcher" />
    </item>
</layer-list>
